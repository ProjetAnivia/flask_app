# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — Modèle de configuration pour IRM FAIR
#
#  USAGE :
#    1. Copie ce fichier en .env :   cp .env.example .env
#    2. Remplis les valeurs ci-dessous
#    3. Le fichier .env est git-ignoré — NE JAMAIS le committer
#    4. Relance Docker :              docker compose up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Sécurité Flask ───────────────────────────────────────────────────────────
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev_secret_change_in_prod

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
# Récupère les clés sur https://www.google.com/recaptcha/admin/create
# Type : reCAPTCHA v3 — domaines : localhost
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ── SMTP (optionnel — pour le reset password par email) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@irm-fair.local
APP_URL=http://localhost:5001

# ── Google Calendar (sync planning ↔ Google Agenda) ──────────────────────────
# 1. Console Google Cloud → créer un projet
# 2. Activer l'API Google Calendar
# 3. Créer un Service Account → télécharger la clé JSON
# 4. Placer le JSON dans ./secrets/google_calendar_sa.json (monté en /secrets dans Docker)
# 5. Créer un Google Calendar partagé, ajouter l'email du service account (droit modif)
# 6. Coller l'ID du calendrier ci-dessous
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_TZ=Europe/Paris
